alias hlog='git log --all --graph --format="%C(yellow)%h %C(green)%G? %C(reset)%aN %C(blue)%ar %C(red)%d %C(reset)%s"'
alias xlog='git log --graph --format="%C(yellow)%h %C(green)%G? %C(reset)%aN %C(blue)%ar %C(red)%d %C(reset)%s"'
alias slog='git log --stat --all --graph --format="%C(yellow)%h %C(reset)%aN %C(blue)%ar %C(red)%d %C(reset)%s"'

alias prettier='npx prettier'
alias spell='aspell list'
